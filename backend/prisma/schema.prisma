generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id         String   @id @default(uuid())
  name       String
  address    String
  starRating Int      @default(3) @map("star_rating")
  imageUrl   String?  @map("image_url")
  rooms      Room[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("hotels")
}

model Room {
  id            String    @id @default(uuid())
  hotelId       String    @map("hotel_id")
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number        String
  type          RoomType  @default(STANDARD)
  pricePerNight Float     @map("price_per_night")
  capacity      Int       @default(2)
  description   String?
  bookings      Booking[]
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([hotelId, number])
  @@map("rooms")
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
}

model Booking {
  id         String        @id @default(uuid())
  roomId     String        @map("room_id")
  room       Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestName  String        @map("guest_name")
  guestEmail String?       @map("guest_email")
  checkIn    DateTime      @map("check_in") @db.Date
  checkOut   DateTime      @map("check_out") @db.Date
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([roomId, status])
  @@map("bookings")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}
